# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/pelleh?retryWrites=true&w=majority

# فقط در صورت خطای "querySrv ECONNREFUSED" و بعد از تست با npm run test:db
# — اختیاری، پیش‌فرض خالی. توضیح کامل در README.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Auth
AUTH_SECRET=replace-with-a-long-random-string

# پنل ادمین — کاملاً جدا از سیستم کاربران عادی (ایمیل/رمز عبور در
# MongoDB). هرکسی آدرس /admin را باز کند فقط فرم ورود را می‌بیند؛ فقط
# با این نام‌کاربری/رمز عبور می‌توان وارد شد.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ورود/ثبت‌نام با گوگل — اختیاری. اگر خالی بماند، دکمه‌ی «ورود با گوگل»
# در صفحه هست ولی کلیک روی آن خطای «پیکربندی نشده» می‌دهد. برای فعال‌سازی:
# ۱) در https://console.cloud.google.com یک OAuth Client (نوع Web
#    application) بسازید.
# ۲) در «Authorized redirect URIs» دقیقاً این مقدار را اضافه کنید
#    (متناسب با NEXT_PUBLIC_SITE_URL واقعی‌تان):
#    https://pelleh.ir/api/auth/google/callback
# ۳) Client ID و Client Secret را اینجا بگذارید.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL — used in metadata, sitemap, robots, canonical tags,
# AND the Google OAuth redirect URI above — must match exactly.
NEXT_PUBLIC_SITE_URL=https://pelleh.ir

# تکمیل SEO دسته‌ها با هوش مصنوعی (پنل ادمین > دسته‌بندی‌ها) — اختیاری.
# از Google Gemini استفاده می‌کند (طرح رایگان دارد). کلید رایگان را از
# https://aistudio.google.com/apikey بگیرید. فقط سمت سرور استفاده می‌شود و
# هرگز به مرورگر نمی‌رسد. اگر خالی بماند فقط دکمه‌های AI غیرفعال می‌شوند.
GEMINI_API_KEY=
# AI_MODEL=gemini-flash-latest
# اگر با خطای 429 (سقف رایگان) روبه‌رو شدید، مدل سبک‌تر با سقف بیشتر:
# AI_MODEL=gemini-flash-lite-latest
# اگر Gemini از سرور/آی‌پی شما در دسترس نیست، آدرس یک پروکسی:
# AI_BASE_URL=https://generativelanguage.googleapis.com
# فقط برای توسعه‌ی لوکال با VPN: Node از VPN سیستم استفاده نمی‌کند، پس آدرس
# پروکسی محلیِ برنامه‌ی VPN را بدهید (مثلاً v2rayN معمولاً 10809، Clash معمولاً 7890):
# AI_PROXY_URL=http://127.0.0.1:10809

# مدل‌هایی که وقتی مدل اصلی شلوغ است (خطای 503/429) به ترتیب امتحان می‌شوند:
# AI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
